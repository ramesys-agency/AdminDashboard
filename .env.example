# Bootstrap admin account — consumed only by `npm run db:seed:prod`,
# never read by the running app. Password must be >= 12 chars; generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_EMAIL=admin@vydhra.com
ADMIN_PASSWORD=
ADMIN_NAME=Vydhra Admin
