generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Business {
  id               String            @id @default(cuid())
  name             String            @unique
  type             BusinessType
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String?
  updatedBy        String?
  agents           Agent[]
  clients          Client[]
  coupons          Coupon[]
  courses          Course[]
  enquiries        Enquiry[]
  invoices         Invoice[]
  payments         Payment[]
  projects         Project[]
  students         Student[]
  referralSettings ReferralSettings?
}

model Client {
  id         String    @id @default(cuid())
  businessId String
  name       String
  email      String    @unique
  phone      String?
  company    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  business   Business  @relation(fields: [businessId], references: [id])
  projects   Project[]
}

model Project {
  id          String    @id @default(cuid())
  businessId  String
  clientId    String
  name        String
  description String?
  status      String
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  invoices    Invoice[]
  payments    Payment[]
  business    Business  @relation(fields: [businessId], references: [id])
  client      Client    @relation(fields: [clientId], references: [id])
}

model Invoice {
  id          String    @id @default(cuid())
  businessId  String
  projectId   String?
  amount      Float
  status      String
  invoiceLink String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  business    Business  @relation(fields: [businessId], references: [id])
  project     Project?  @relation(fields: [projectId], references: [id])
  payments    Payment[]
}

model Student {
  id               String             @id @default(cuid())
  businessId       String
  name             String
  email            String             @unique
  phone            String?
  country          String?
  // Student referral program: null override fields fall back to ReferralSettings
  referralCode     String?            @unique
  discountType     DiscountType?
  discountValue    Float?
  commissionType   CommissionType?
  commissionValue  Float?
  totalEarned      Float              @default(0)
  totalPaid        Float              @default(0)
  additionalAmount Float              @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        String?
  updatedBy        String?
  enrollments      CourseEnrollment[]
  payments         Payment[]          @relation("StudentPayments")
  referredPayments Payment[]          @relation("ReferrerStudentPayments")
  business         Business           @relation(fields: [businessId], references: [id])
}

model Course {
  id          String             @id @default(cuid())
  businessId  String
  slug        String             @unique
  name        String
  description String?
  details     Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   String?
  updatedBy   String?
  business    Business           @relation(fields: [businessId], references: [id])
  enrollments CourseEnrollment[]
  batches     CourseBatch[]
  pricing     CoursePricing[]
}

model CoursePricing {
  id            String @id @default(cuid())
  courseId      String
  currency      String
  amount        Float
  originalPrice Float?
  course        Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, currency])
}

model CourseBatch {
  id               String             @id @default(cuid())
  courseId         String
  name             String
  startDate        DateTime
  endDate          DateTime
  maxSeats         Int?
  status           BatchStatus        @default(UPCOMING)
  whatsappGroupUrl String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        String?
  updatedBy        String?
  course           Course             @relation(fields: [courseId], references: [id])
  enrollments      CourseEnrollment[]
  pricing          BatchPricing[]
}

model BatchPricing {
  id            String      @id @default(cuid())
  batchId       String
  currency      String
  amount        Float
  originalPrice Float?
  batch         CourseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, currency])
}

model CourseEnrollment {
  id              String       @id @default(cuid())
  studentId       String
  courseId        String
  batchId         String?
  status          String
  acceptedTerms   Boolean      @default(false)
  acceptedTermsAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdBy       String?
  updatedBy       String?
  batch           CourseBatch? @relation(fields: [batchId], references: [id])
  course          Course       @relation(fields: [courseId], references: [id])
  student         Student      @relation(fields: [studentId], references: [id])
  payments        Payment[]
}

model Agent {
  id               String         @id @default(cuid())
  businessId       String
  name             String
  email            String         @unique
  phone            String?
  code             String         @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdBy        String?
  updatedBy        String?
  additionalAmount Float          @default(0)
  commissionType   CommissionType @default(PERCENTAGE) // Same as discountType from Coupons
  commissionValue  Float          @default(10) // Same as discountValue from Coupons
  totalEarned      Float          @default(0)
  totalPaid        Float          @default(0)
  business         Business       @relation(fields: [businessId], references: [id])
  payments         Payment[]
}

model Coupon {
  id          String           @id @default(cuid())
  businessId  String
  code        String           @unique
  maxUses     Int?
  currentUses Int              @default(0)
  validUntil  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?
  updatedBy   String?
  business    Business         @relation(fields: [businessId], references: [id])
  payments    Payment[]
  discounts   CouponDiscount[]
}

model CouponDiscount {
  id            String       @id @default(cuid())
  couponId      String
  currency      String
  discountType  DiscountType
  discountValue Float
  coupon        Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, currency])
}

model Enquiry {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String
  phone      String?
  message    String?
  status     String   @default("NEW")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  updatedBy  String?
  business   Business @relation(fields: [businessId], references: [id])
}

model Payment {
  id                 String            @id @default(cuid())
  businessId         String
  amount             Float
  currency           String            @default("USD")
  amountInINR        Float?
  exchangeRate       Float?
  status             String
  method             String?
  projectId          String?
  invoiceId          String?
  studentId          String?
  courseEnrollmentId String?
  agentId            String?
  couponId           String?
  referrerStudentId  String?
  razorpayOrderId    String?
  razorpayPaymentId  String?           @unique
  razorpaySignature  String?
  acceptedTerms      Boolean           @default(false)
  acceptedTermsAt    DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          String?
  updatedBy          String?
  agent              Agent?            @relation(fields: [agentId], references: [id])
  business           Business          @relation(fields: [businessId], references: [id])
  coupon             Coupon?           @relation(fields: [couponId], references: [id])
  invoice            Invoice?          @relation(fields: [invoiceId], references: [id])
  project            Project?          @relation(fields: [projectId], references: [id])
  student            Student?          @relation("StudentPayments", fields: [studentId], references: [id])
  referrerStudent    Student?          @relation("ReferrerStudentPayments", fields: [referrerStudentId], references: [id])
  courseEnrollment   CourseEnrollment? @relation(fields: [courseEnrollmentId], references: [id])
}

model ReferralSettings {
  id                     String         @id @default(cuid())
  businessId             String         @unique
  // Student referral program (defaults; per-student overrides live on Student)
  studentReferralEnabled Boolean        @default(true)
  studentDiscountType    DiscountType   @default(PERCENTAGE)
  studentDiscountValue   Float          @default(10)
  studentCommissionType  CommissionType @default(PERCENTAGE)
  studentCommissionValue Float          @default(10)
  // Defaults applied when creating new agents (per-agent values live on Agent/Coupon)
  agentDiscountType      DiscountType   @default(PERCENTAGE)
  agentDiscountValue     Float          @default(10)
  agentCommissionType    CommissionType @default(PERCENTAGE)
  agentCommissionValue   Float          @default(10)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  updatedBy              String?
  business               Business       @relation(fields: [businessId], references: [id])
}

enum BusinessType {
  IT_SERVICES
  COURSE_SELLING
  OTHER
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CommissionType {
  PERCENTAGE
  FLAT
}

enum DiscountType {
  PERCENTAGE
  FLAT
}
